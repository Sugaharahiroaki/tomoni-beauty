# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
# 本番: DATABASE_URL=postgres://tomoni:password@127.0.0.1:5432/tomoni
DATABASE_URL=
MEDIA_ROOT=

# ---- Background jobs ----
# true なら同期実行（ワーカー不要・開発向け）。本番は false にして `manage.py qcluster` を常駐させる
Q_SYNC=true
Q_WORKERS=2

# ---- AI ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_FALLBACKS_ENABLED=true
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# キー未設定時は自動でダミー実装になる。明示したい場合のみ指定
# AI_FAKE=true
# TRANSCRIPTION_FAKE=true

# ---- LINE ----
LINE_REPLY_TOKEN_TTL_SECONDS=50
LINE_CHAT_URL_TEMPLATE=https://chat.line.biz/{bot_user_id}/chat/{line_user_id}
LINE_FREE_PLAN_MONTHLY_LIMIT=200

# ---- 業務ルール ----
ATTRIBUTION_WINDOW_DAYS=14
MIN_DAYS_BETWEEN_SAME_KIND_MESSAGES=7

# ---- n8n 等の内部連携 ----
INTERNAL_API_TOKEN=
LOG_LEVEL=INFO

# ---- SNS動画投稿（リール） ----
# ナレーション（Gemini TTS）。無ければテロップ＋BGMだけの動画になる
GEMINI_API_KEY=
# 投稿先の接続（運営がMeta/Google側でアプリを作ったら記入。無ければ「お試し投稿」になり実際には投稿されない）
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v25.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# 動画の公開URL（Instagramが取りに来る）。既定は SITE_URL/media
PUBLIC_MEDIA_BASE_URL=
RENDER_WORK_DIR=
# 接続トークンの暗号化鍵（Fernet）。未設定なら DJANGO_SECRET_KEY から生成。本番では固定の鍵を入れる
FIELD_ENCRYPTION_KEY=
# テロップ用の日本語フォント（未設定なら自動で探す。Linuxは fonts-noto-cjk）
ENGINE_FONT=
BGM_REQUIRE_LICENSE=false
SOCIAL_BEST_HOURS=12,19
MEDIA_ACCEL_REDIRECT=false
